---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Free online calculators and everyday utility tools.' } = Astro.props;
const pageTitle = title === 'UtilityBox' ? title : `${title} | UtilityBox`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL('/og-image.png', Astro.site);

const navGroups = [
  {
    label: 'Calculators',
    links: [
      { href: '/tools/scientific', label: 'Scientific' },
      { href: '/tools/currency', label: 'Currency' },
      { href: '/tools/measurements', label: 'Units' },
      { href: '/tools/uk-salary', label: 'UK Salary' },
      { href: '/tools/percentage', label: 'Percentage' },
      { href: '/tools/vat', label: 'VAT' },
      { href: '/tools/tip', label: 'Tip' },
      { href: '/tools/loan', label: 'Loan Repayment' }
    ]
  },
  {
    label: 'Networking',
    links: [
      { href: '/tools/network', label: 'Network / CIDR' },
      { href: '/tools/ipv6-subnet', label: 'IPv6 Subnet' },
      { href: '/tools/ip-converter', label: 'IP Converter' },
      { href: '/tools/dns-lookup', label: 'DNS Lookup' },
      { href: '/tools/dns-records', label: 'DNS Record Reference' },
      { href: '/tools/http-status', label: 'HTTP Status Codes' },
      { href: '/tools/port-lookup', label: 'Port Lookup' },
      { href: '/tools/mac-address', label: 'MAC Address' },
      { href: '/tools/bandwidth', label: 'Bandwidth Calculator' }
    ]
  },
  {
    label: 'Word Games',
    links: [
      { href: '/tools/unscrambler', label: 'Unscrambler' },
      { href: '/tools/word-builder', label: 'Word Builder' },
      { href: '/tools/word-counter', label: 'Word Counter' },
      { href: '/tools/case-converter', label: 'Case Converter' },
      { href: '/tools/palindrome', label: 'Palindrome Checker' },
      { href: '/tools/anagram', label: 'Anagram Solver' }
    ]
  },
  {
    label: 'Generators',
    links: [
      { href: '/tools/random-string', label: 'Random String' },
      { href: '/tools/lorem', label: 'Lorem Ipsum' },
      { href: '/tools/color-converter', label: 'Color Converter' },
      { href: '/tools/slug', label: 'Slug Generator' },
      { href: '/tools/placeholder-image', label: 'Placeholder Image' }
    ]
  },
  {
    label: 'Developer Tools',
    links: [
      { href: '/tools/json-formatter', label: 'JSON Formatter' },
      { href: '/tools/regex-tester', label: 'Regex Tester' },
      { href: '/tools/diff-viewer', label: 'Diff Viewer' },
      { href: '/tools/base64', label: 'Base64' },
      { href: '/tools/jwt-decoder', label: 'JWT Decoder' },
      { href: '/tools/cron-parser', label: 'Cron Parser' },
      { href: '/tools/hash-generator', label: 'Hash Generator' },
      { href: '/tools/url-encoder', label: 'URL Encoder' },
      { href: '/tools/timestamp', label: 'Timestamp Converter' },
      { href: '/tools/html-entities', label: 'HTML Entities' }
    ]
  }
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2563eb" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="UtilityBox" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script async is:inline src="https://fundingchoicesmessages.google.com/i/pub-5536568662323664?ers=1"></script>
    <script is:inline>
      (function () {
        function signalGooglefcPresent() {
          if (!window.frames['googlefcPresent']) {
            if (document.body) {
              const iframe = document.createElement('iframe');
              iframe.style = 'width: 0; height: 0; border: none; z-index: -1000; left: -1000px; top: -1000px;';
              iframe.style.display = 'none';
              iframe.name = 'googlefcPresent';
              document.body.appendChild(iframe);
            } else {
              setTimeout(signalGooglefcPresent, 0);
            }
          }
        }
        signalGooglefcPresent();
      })();
    </script>

    <script
      async
      is:inline
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5536568662323664"
      crossorigin="anonymous"></script>

    <script is:inline>
      // Applied before paint to avoid a flash of the wrong theme.
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <span class="brand-mark">UB</span>
          <span>UtilityBox</span>
        </a>
        <nav class="site-nav" aria-label="Tools">
          <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-menu">
            <span class="visually-hidden">Toggle navigation</span>
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
          </button>
          <div class="nav-menu" id="nav-menu">
            {navGroups.map((group) =>
              group.links.length === 1 ? (
                <a class="nav-single" href={group.links[0].href}>{group.label}</a>
              ) : (
                <details class="nav-group">
                  <summary>{group.label}</summary>
                  <ul class="nav-group-list">
                    {group.links.map((link) => (
                      <li><a href={link.href}>{link.label}</a></li>
                    ))}
                  </ul>
                </details>
              )
            )}
          </div>
        </nav>
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode" type="button">
          <span id="theme-icon" aria-hidden="true">🌙</span>
        </button>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>&copy; {new Date().getFullYear()} UtilityBox. Free calculators and tools, no sign-up required.</p>
        <p class="footer-links">
          <a href="/">Home</a>
          <span aria-hidden="true">·</span>
          <a href="/privacy/">Privacy Policy</a>
          <span aria-hidden="true">·</span>
          <a href="/terms/">Terms of Use</a>
          <span aria-hidden="true">·</span>
          <a href="https://ko-fi.com/alexm95904" target="_blank" rel="noopener noreferrer">☕ Support on Ko-fi</a>
          <span aria-hidden="true">·</span>
          <span>🔒 No accounts, no tracking cookies</span>
        </p>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('theme-toggle');
      const icon = document.getElementById('theme-icon');

      function currentTheme(): 'light' | 'dark' {
        const attr = document.documentElement.getAttribute('data-theme');
        if (attr === 'dark' || attr === 'light') return attr;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }

      function updateIcon() {
        if (icon) icon.textContent = currentTheme() === 'dark' ? '☀️' : '🌙';
      }

      toggle?.addEventListener('click', () => {
        const next = currentTheme() === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        updateIcon();
      });

      updateIcon();

      const navToggle = document.getElementById('nav-toggle');
      const navMenu = document.getElementById('nav-menu');
      navToggle?.addEventListener('click', () => {
        const expanded = navToggle.getAttribute('aria-expanded') === 'true';
        navToggle.setAttribute('aria-expanded', String(!expanded));
        navMenu?.classList.toggle('open');
      });

      const navGroupEls = document.querySelectorAll<HTMLDetailsElement>('.nav-group');
      navGroupEls.forEach((details) => {
        details.addEventListener('toggle', () => {
          if (details.open) {
            navGroupEls.forEach((other) => {
              if (other !== details) other.open = false;
            });
          }
        });
      });

      document.addEventListener('click', (event) => {
        const target = event.target as Node;
        navGroupEls.forEach((details) => {
          if (details.open && !details.contains(target)) details.open = false;
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          navGroupEls.forEach((details) => { details.open = false; });
        }
      });
    </script>

    <style>
      .skip-link {
        position: absolute;
        top: -100%;
        left: var(--space-4);
        z-index: 100;
        background: var(--color-primary);
        color: var(--color-primary-contrast);
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-md);
        font-weight: 600;
        transition: top 0.15s ease;
      }
      .skip-link:focus {
        top: var(--space-3);
      }

      main:focus {
        outline: none;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-border);
      }

      .header-inner {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        padding-block: var(--space-3);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        font-weight: 800;
        font-size: 1.1rem;
        color: var(--color-text);
        flex-shrink: 0;
      }
      .brand:hover { text-decoration: none; }

      .brand-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: var(--radius-md);
        background: var(--color-primary);
        color: var(--color-primary-contrast);
        font-size: 0.85rem;
        font-weight: 800;
      }

      .site-nav {
        flex: 1;
        min-width: 0;
      }

      .nav-menu {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-1) var(--space-4);
      }

      .nav-single {
        color: var(--color-text-muted);
        font-size: 0.9rem;
        font-weight: 600;
        white-space: nowrap;
      }
      .nav-single:hover {
        color: var(--color-primary);
        text-decoration: none;
      }

      .nav-group {
        position: relative;
      }

      .nav-group summary {
        list-style: none;
        cursor: pointer;
        color: var(--color-text-muted);
        font-size: 0.9rem;
        font-weight: 600;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 4px;
        user-select: none;
      }
      .nav-group summary::-webkit-details-marker {
        display: none;
      }
      .nav-group summary::after {
        content: '';
        width: 6px;
        height: 6px;
        border-right: 2px solid currentColor;
        border-bottom: 2px solid currentColor;
        transform: rotate(45deg);
        margin-top: -3px;
        transition: transform 0.15s ease;
      }
      .nav-group[open] summary::after {
        transform: rotate(-135deg);
        margin-top: 3px;
      }
      .nav-group summary:hover,
      .nav-group[open] summary {
        color: var(--color-primary);
      }

      .nav-group-list {
        list-style: none;
        margin: 0;
        padding: var(--space-2);
      }

      .nav-group-list a {
        display: block;
        padding: var(--space-2) var(--space-3);
        border-radius: var(--radius-sm);
        color: var(--color-text);
        font-size: 0.9rem;
        white-space: nowrap;
      }
      .nav-group-list a:hover {
        background: var(--color-surface-alt);
        color: var(--color-primary);
        text-decoration: none;
      }

      /* Desktop: dropdown panel anchored under the group's summary. */
      @media (min-width: 781px) {
        .nav-group-list {
          position: absolute;
          top: calc(100% + var(--space-2));
          left: 0;
          min-width: 190px;
          background: var(--color-surface);
          border: 1px solid var(--color-border);
          border-radius: var(--radius-md);
          box-shadow: var(--shadow-md);
          z-index: 60;
        }
      }

      .nav-toggle {
        display: none;
        flex-direction: column;
        gap: 4px;
        background: none;
        border: none;
        padding: var(--space-2);
        cursor: pointer;
      }
      .nav-toggle-bar {
        width: 22px;
        height: 2px;
        background: var(--color-text);
        border-radius: 1px;
      }

      .theme-toggle {
        background: var(--color-surface-alt);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 1.1rem;
        flex-shrink: 0;
      }

      main {
        min-height: 60vh;
      }

      .site-footer {
        border-top: 1px solid var(--color-border);
        margin-top: var(--space-8);
        padding-block: var(--space-6);
      }
      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--space-3);
        color: var(--color-text-muted);
        font-size: 0.9rem;
      }
      .footer-links a { color: var(--color-text-muted); }

      @media (max-width: 780px) {
        .nav-toggle { display: inline-flex; }
        .nav-menu {
          display: none;
          flex-direction: column;
          align-items: stretch;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          background: var(--color-surface);
          border-bottom: 1px solid var(--color-border);
          padding: var(--space-3) var(--space-5);
        }
        .nav-menu.open { display: flex; }
        .site-nav { position: relative; order: 3; flex-basis: 100%; }
        .header-inner { flex-wrap: wrap; }

        .nav-single {
          padding: var(--space-2) 0;
        }
        .nav-group summary {
          padding: var(--space-2) 0;
        }
        .nav-group-list {
          padding: 0 0 var(--space-2) var(--space-4);
        }
      }
    </style>
  </body>
</html>
