---
import ToolLayout from '../../components/ToolLayout.astro';
import CronParser from '../../components/tools/CronParser.astro';
import { toolSchema, faqSchema } from '../../utils/seo';

const description =
  'Free cron expression parser. Understand what a cron schedule means in plain English and see its next run times.';

const faqs = [
  {
    question: 'What do the five fields in a cron expression mean?',
    answer:
      'In order: minute (0-59), hour (0-23), day of month (1-31), month (1-12), and day of week (0-7, where both 0 and 7 mean Sunday). A job runs whenever the current time matches every field, so 0 9 * * 1-5 means minute 0, hour 9, any day of month, any month, Monday through Friday — 9:00 AM on weekdays.'
  },
  {
    question: 'What does an asterisk (*) mean in cron?',
    answer: 'An asterisk means "every value is allowed" for that field — no restriction. A schedule of * * * * * runs every single minute.'
  },
  {
    question: 'How do step values like */15 work?',
    answer:
      "*/15 in the minute field means every 15th value starting from the field's minimum — 0, 15, 30, 45 — so */15 * * * * runs at the top of the hour and every 15 minutes after. A step can also apply to a range, like 0-30/10."
  },
  {
    question: 'What happens if both day-of-month and day-of-week are restricted?',
    answer:
      "When both fields are set to something other than *, standard cron behavior — which this tool follows — treats it as OR rather than AND: the job runs if either condition is satisfied. So 0 0 1 * 1 runs on the 1st of the month or every Monday, whichever comes first, not only on days when both happen to coincide."
  }
];

const schema = [
  toolSchema({ name: 'Cron Expression Parser', description, path: '/tools/cron-parser/' }),
  faqSchema(faqs)
];
---

<ToolLayout
  title="Cron Expression Parser"
  description={description}
  category="Developer Tools"
  schema={schema}
>
  <CronParser />

  <Fragment slot="sidebar">
    <div class="card side-card">
      <h3>Field order</h3>
      <p>Standard 5-field cron: minute, hour, day-of-month, month, day-of-week. Supports ranges (<code>1-5</code>), lists (<code>1,3,5</code>), steps (<code>*/15</code>), and month/day names.</p>
    </div>
  </Fragment>

  <Fragment slot="content">
    <section class="tool-content">
      <h2>Worked example</h2>
      <p>
        <code>0 9 * * 1-5</code> means: minute 0, hour 9, any day of month, any month, Monday through Friday —
        in plain English, "every weekday at 9:00 AM".
      </p>

      <h2>Frequently asked questions</h2>
      {faqs.map((faq) => (
        <div class="faq-item">
          <h3>{faq.question}</h3>
          <p>{faq.answer}</p>
        </div>
      ))}
    </section>
  </Fragment>
</ToolLayout>

<style>
  .side-card code {
    background: var(--color-surface-alt);
    padding: 1px 5px;
    border-radius: 4px;
  }
</style>
