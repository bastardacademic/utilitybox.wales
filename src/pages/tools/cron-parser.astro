---
import ToolLayout from '../../components/ToolLayout.astro';
import CronParser from '../../components/tools/CronParser.astro';
import { toolSchema } from '../../utils/seo';

const description =
  'Free cron expression parser. Understand what a cron schedule means in plain English and see its next run times.';
const schema = toolSchema({ name: 'Cron Expression Parser', description, path: '/tools/cron-parser/' });
---

<ToolLayout
  title="Cron Expression Parser"
  description={description}
  category="Developer Tools"
  schema={schema}
>
  <CronParser />

  <Fragment slot="sidebar">
    <div class="card side-card">
      <h3>Field order</h3>
      <p>Standard 5-field cron: minute, hour, day-of-month, month, day-of-week. Supports ranges (<code>1-5</code>), lists (<code>1,3,5</code>), steps (<code>*/15</code>), and month/day names.</p>
    </div>
  </Fragment>
</ToolLayout>

<style>
  .side-card code {
    background: var(--color-surface-alt);
    padding: 1px 5px;
    border-radius: 4px;
  }
</style>
