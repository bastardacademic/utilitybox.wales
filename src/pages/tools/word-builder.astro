---
import ToolLayout from '../../components/ToolLayout.astro';
import WordBuilder from '../../components/tools/WordBuilder.astro';
import { toolSchema } from '../../utils/seo';

const description =
  'Free word builder for word games. Find every valid word from your available letters, with pattern matching and point scoring.';
const schema = toolSchema({ name: 'Word Builder', description, path: '/tools/word-builder/' });
---

<ToolLayout
  title="Word Builder"
  description={description}
  category="Word Games"
  schema={schema}
>
  <WordBuilder />

  <Fragment slot="sidebar">
    <div class="card side-card">
      <h3>Pattern matching</h3>
      <p>Use <code>_</code> as a wildcard in the pattern field, e.g. <code>c_t</code> matches "cat" and "cot".</p>
    </div>
  </Fragment>
</ToolLayout>

<p class="container dictionary-credit">
  Word list includes data from the <a href="https://github.com/rdeits/cryptics/blob/master/raw_data/UKACD.txt" target="_blank" rel="noopener noreferrer">UK Advanced Cryptics Dictionary (UKACD)</a>, © J Ross Beresford 1993–2009, used under its BSD-style license.
</p>

<style>
  .side-card code {
    background: var(--color-surface-alt);
    padding: 1px 5px;
    border-radius: 4px;
  }

  .dictionary-credit {
    padding-bottom: var(--space-6);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
</style>
