---
import ToolLayout from '../../components/ToolLayout.astro';
import LoremIpsum from '../../components/tools/LoremIpsum.astro';
import { toolSchema, faqSchema } from '../../utils/seo';

const description =
  'Free Lorem Ipsum generator. Create placeholder text by word, sentence or paragraph for design mockups and layouts.';

const faqs = [
  {
    question: 'What is Lorem Ipsum, and does it mean anything?',
    answer:
      'Lorem Ipsum is scrambled, altered Latin derived from a passage of Cicero\'s De Finibus Bonorum et Malorum (written around 45 BC). It\'s been garbled enough over centuries of use that it no longer forms coherent Latin sentences — which is exactly the point, since meaningless text keeps a design mockup\'s audience from being distracted by content.'
  },
  {
    question: 'Why use Lorem Ipsum instead of real text in a mockup?',
    answer:
      "Real, readable text pulls a viewer's attention to what it says rather than how it looks — which defeats the purpose when you're trying to get feedback on layout, spacing, and typography. Lorem Ipsum's familiar, roughly-natural letter and word-length distribution fills space realistically without being readable enough to distract."
  },
  {
    question: 'What is the difference between generating by word, sentence, or paragraph?',
    answer:
      "It just controls the unit of output: word mode gives you a specific word count with no sentence structure, sentence mode gives complete sentences, and paragraph mode groups sentences into paragraphs — useful depending on whether you're filling a short label, a line of body copy, or a whole content block."
  }
];

const schema = [toolSchema({ name: 'Lorem Ipsum Generator', description, path: '/tools/lorem/' }), faqSchema(faqs)];
---

<ToolLayout
  title="Lorem Ipsum Generator"
  description={description}
  category="Generators"
  schema={schema}
>
  <LoremIpsum />

  <Fragment slot="sidebar">
    <div class="card side-card">
      <h3>Why Lorem Ipsum?</h3>
      <p>Placeholder Latin-esque text keeps focus on layout and typography rather than readable content during design.</p>
    </div>
  </Fragment>

  <Fragment slot="content">
    <section class="tool-content">
      <h2>Frequently asked questions</h2>
      {faqs.map((faq) => (
        <div class="faq-item">
          <h3>{faq.question}</h3>
          <p>{faq.answer}</p>
        </div>
      ))}
    </section>
  </Fragment>
</ToolLayout>
