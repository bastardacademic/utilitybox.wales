---
import ToolLayout from '../../components/ToolLayout.astro';
import WordUnscrambler from '../../components/tools/WordUnscrambler.astro';
import { toolSchema } from '../../utils/seo';

const description =
  'Free word unscrambler. Enter scrambled letters and instantly find every valid word, grouped by length and scored for word games.';
const schema = toolSchema({ name: 'Word Unscrambler', description, path: '/tools/unscrambler/' });
---

<ToolLayout
  title="Word Unscrambler"
  description={description}
  category="Word Games"
  schema={schema}
>
  <WordUnscrambler />

  <Fragment slot="sidebar">
    <div class="card side-card">
      <h3>How it works</h3>
      <p>Enter your letters and we'll search a dictionary of common English words for every valid match, including sub-words shorter than your full rack.</p>
    </div>
  </Fragment>
</ToolLayout>

<p class="container dictionary-credit">
  Word list includes data from the <a href="https://github.com/rdeits/cryptics/blob/master/raw_data/UKACD.txt" target="_blank" rel="noopener noreferrer">UK Advanced Cryptics Dictionary (UKACD)</a>, © J Ross Beresford 1993–2009, used under its BSD-style license.
</p>

<style>
  .dictionary-credit {
    padding-bottom: var(--space-6);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
</style>
