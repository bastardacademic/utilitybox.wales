---
import Layout from '../layouts/Layout.astro';

const popularTools = [
  { href: '/tools/scientific', label: 'Scientific Calculator' },
  { href: '/tools/currency', label: 'Currency Converter' },
  { href: '/tools/measurements', label: 'Unit Converter' },
  { href: '/tools/uk-salary', label: 'UK Salary Calculator' }
];
---

<Layout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <div class="container not-found">
    <p class="not-found-code">404</p>
    <h1>Page not found</h1>
    <p class="not-found-copy">That page doesn't exist, or it's moved. Try one of these instead:</p>

    <ul class="not-found-links">
      {popularTools.map((tool) => (
        <li><a href={tool.href}>{tool.label}</a></li>
      ))}
    </ul>

    <a href="/" class="btn">Back to home</a>
  </div>
</Layout>

<style>
  .not-found {
    padding-block: var(--space-8);
    text-align: center;
    max-width: 480px;
  }

  .not-found-code {
    font-size: 4rem;
    font-weight: 800;
    color: var(--color-primary);
    margin: 0;
    line-height: 1;
  }

  .not-found-copy {
    color: var(--color-text-muted);
  }

  .not-found-links {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .not-found-links a {
    font-weight: 600;
  }
</style>
