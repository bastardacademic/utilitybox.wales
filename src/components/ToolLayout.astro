---
import Layout from '../layouts/Layout.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  /** Optional JSON-LD object(s) (e.g. a schema.org WebApplication or FAQPage record) rendered as structured data. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Optional links to related tool pages, rendered as a "Related tools" sidebar card. */
  relatedTools?: { href: string; label: string }[];
}

const { title, description, category, schema, relatedTools } = Astro.props;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://utilitybox.wales/' },
    { '@type': 'ListItem', position: 2, name: title, item: `https://utilitybox.wales${Astro.url.pathname}` }
  ]
};
---

<Layout title={title} description={description}>
  {schemas.map((entry) => (
    <script type="application/ld+json" set:html={JSON.stringify(entry)} />
  ))}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="container tool-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span class="tag">{category}</span>
    </nav>

    <div class="tool-header">
      <h1>{title}</h1>
      <p class="tool-description">{description}</p>
    </div>

    <div class="tool-grid">
      <section class="tool-main card">
        <slot />
      </section>

      <aside class="tool-side">
        <slot name="sidebar">
          <div class="card side-card">
            <h3>About this tool</h3>
            <p>{description}</p>
          </div>
        </slot>

        {relatedTools && relatedTools.length > 0 && (
          <div class="card side-card">
            <h3>Related tools</h3>
            <ul class="related-tools-list">
              {relatedTools.map((tool) => (
                <li><a href={tool.href}>{tool.label}</a></li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>

    <slot name="content" />
  </div>
</Layout>

<style>
  .tool-page {
    padding-block: var(--space-6) var(--space-8);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    font-size: 0.85rem;
  }
  .breadcrumb a { color: var(--color-text-muted); }
  .breadcrumb span[aria-hidden] { color: var(--color-text-muted); }

  .tool-header {
    margin-bottom: var(--space-6);
    max-width: 720px;
  }

  .tool-description {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    margin-bottom: 0;
  }

  .tool-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }

  .tool-main {
    padding: var(--space-5);
  }

  .tool-side {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: sticky;
    top: calc(var(--space-6) + 60px);
  }

  @media (max-width: 900px) {
    .tool-grid {
      grid-template-columns: 1fr;
    }
    .tool-side {
      position: static;
    }
  }

  .related-tools-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
</style>

<style is:global>
  .tool-content {
    max-width: 720px;
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .tool-content h2 {
    margin-top: var(--space-6);
  }

  .tool-content h2:first-child {
    margin-top: 0;
  }

  .tool-content .faq-item {
    margin-bottom: var(--space-4);
  }

  .tool-content .faq-item h3 {
    margin-bottom: var(--space-1);
  }

  .tool-content .faq-item p {
    margin-bottom: 0;
    color: var(--color-text-muted);
  }
</style>
