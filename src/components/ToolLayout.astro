---
import Layout from '../layouts/Layout.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  /** Optional JSON-LD object (e.g. a schema.org WebApplication record) rendered as structured data. */
  schema?: Record<string, unknown>;
}

const { title, description, category, schema } = Astro.props;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://utilitybox.wales/' },
    { '@type': 'ListItem', position: 2, name: title, item: `https://utilitybox.wales${Astro.url.pathname}` }
  ]
};
---

<Layout title={title} description={description}>
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="container tool-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span class="tag">{category}</span>
    </nav>

    <div class="tool-header">
      <h1>{title}</h1>
      <p class="tool-description">{description}</p>
    </div>

    <div class="tool-grid">
      <section class="tool-main card">
        <slot />
      </section>

      <aside class="tool-side">
        <slot name="sidebar">
          <div class="card side-card">
            <h3>About this tool</h3>
            <p>{description}</p>
          </div>
        </slot>
      </aside>
    </div>
  </div>
</Layout>

<style>
  .tool-page {
    padding-block: var(--space-6) var(--space-8);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    font-size: 0.85rem;
  }
  .breadcrumb a { color: var(--color-text-muted); }
  .breadcrumb span[aria-hidden] { color: var(--color-text-muted); }

  .tool-header {
    margin-bottom: var(--space-6);
    max-width: 720px;
  }

  .tool-description {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    margin-bottom: 0;
  }

  .tool-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }

  .tool-main {
    padding: var(--space-5);
  }

  .side-card {
    padding: var(--space-4);
  }

  .side-card h3 {
    margin-bottom: var(--space-2);
    font-size: 1rem;
  }

  .side-card p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 0;
  }

  .tool-side {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: sticky;
    top: calc(var(--space-6) + 60px);
  }

  @media (max-width: 900px) {
    .tool-grid {
      grid-template-columns: 1fr;
    }
    .tool-side {
      position: static;
    }
  }
</style>
