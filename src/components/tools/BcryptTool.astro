---
---

<div class="bcrypt-tool">
  <div class="bcrypt-mode">
    <label><input type="radio" name="bcrypt-mode" value="hash" checked /> Hash a password</label>
    <label><input type="radio" name="bcrypt-mode" value="verify" /> Verify a password</label>
  </div>

  <div id="bcrypt-hash-panel">
    <div class="bcrypt-row">
      <div class="field">
        <label class="label" for="bcrypt-password">Password</label>
        <input id="bcrypt-password" class="input mono-input" type="text" spellcheck="false" placeholder="Enter a password" />
      </div>
      <div class="field">
        <label class="label" for="bcrypt-rounds">Salt rounds: <span id="bcrypt-rounds-value">10</span></label>
        <input id="bcrypt-rounds" type="range" min="4" max="14" value="10" class="range-input" />
      </div>
    </div>
    <p class="bcrypt-note" id="bcrypt-truncate-warning" hidden>
      ⚠️ Bcrypt only uses the first 72 bytes of a password — anything beyond that is silently ignored.
    </p>
    <button type="button" id="bcrypt-hash-btn" class="btn">Hash</button>
    <p class="bcrypt-note" id="bcrypt-hash-status" role="status" aria-live="polite"></p>

    <div class="field">
      <div class="field-header">
        <span class="label">Bcrypt hash</span>
        <button type="button" class="copy-btn" id="bcrypt-copy">Copy</button>
      </div>
      <div class="result-box mono-input" id="bcrypt-hash-output"></div>
    </div>
  </div>

  <div id="bcrypt-verify-panel" hidden>
    <div class="field">
      <label class="label" for="bcrypt-verify-password">Password</label>
      <input id="bcrypt-verify-password" class="input mono-input" type="text" spellcheck="false" placeholder="Enter a password" />
    </div>
    <div class="field">
      <label class="label" for="bcrypt-verify-hash">Bcrypt hash</label>
      <input id="bcrypt-verify-hash" class="input mono-input" type="text" spellcheck="false" placeholder="$2a$10$..." />
    </div>
    <button type="button" id="bcrypt-verify-btn" class="btn">Verify</button>
    <p class="bcrypt-note" id="bcrypt-verify-result" role="status" aria-live="polite"></p>
  </div>
</div>

<script>
  import { hashPassword, verifyPassword, getHashRounds, passwordExceedsBcryptLimit, isValidBcryptHash } from '../../utils/bcryptTool';

  const modeRadios = document.querySelectorAll<HTMLInputElement>('input[name="bcrypt-mode"]');
  const hashPanel = document.getElementById('bcrypt-hash-panel') as HTMLElement;
  const verifyPanel = document.getElementById('bcrypt-verify-panel') as HTMLElement;

  const passwordInput = document.getElementById('bcrypt-password') as HTMLInputElement;
  const roundsInput = document.getElementById('bcrypt-rounds') as HTMLInputElement;
  const roundsValue = document.getElementById('bcrypt-rounds-value') as HTMLElement;
  const truncateWarning = document.getElementById('bcrypt-truncate-warning') as HTMLElement;
  const hashBtn = document.getElementById('bcrypt-hash-btn') as HTMLButtonElement;
  const hashStatus = document.getElementById('bcrypt-hash-status') as HTMLElement;
  const hashOutput = document.getElementById('bcrypt-hash-output') as HTMLElement;
  const copyBtn = document.getElementById('bcrypt-copy') as HTMLButtonElement;

  const verifyPasswordInput = document.getElementById('bcrypt-verify-password') as HTMLInputElement;
  const verifyHashInput = document.getElementById('bcrypt-verify-hash') as HTMLInputElement;
  const verifyBtn = document.getElementById('bcrypt-verify-btn') as HTMLButtonElement;
  const verifyResult = document.getElementById('bcrypt-verify-result') as HTMLElement;

  modeRadios.forEach((radio) =>
    radio.addEventListener('change', () => {
      const isHash = (document.querySelector('input[name="bcrypt-mode"]:checked') as HTMLInputElement).value === 'hash';
      hashPanel.hidden = !isHash;
      verifyPanel.hidden = isHash;
    })
  );

  roundsInput.addEventListener('input', () => {
    roundsValue.textContent = roundsInput.value;
  });

  passwordInput.addEventListener('input', () => {
    truncateWarning.hidden = !passwordExceedsBcryptLimit(passwordInput.value);
  });

  hashBtn.addEventListener('click', async () => {
    const password = passwordInput.value;
    if (!password) {
      hashStatus.textContent = 'Enter a password first.';
      return;
    }
    const rounds = parseInt(roundsInput.value, 10);
    hashBtn.disabled = true;
    hashStatus.textContent = rounds >= 13 ? 'Hashing — higher salt rounds can take several seconds…' : 'Hashing…';
    hashOutput.textContent = '';
    try {
      const result = await hashPassword(password, rounds);
      hashOutput.textContent = result;
      hashStatus.textContent = 'Done — generated entirely in your browser, never sent anywhere.';
    } catch (err) {
      hashStatus.textContent = err instanceof Error ? err.message : 'Could not generate a hash.';
    } finally {
      hashBtn.disabled = false;
    }
  });

  copyBtn.addEventListener('click', async () => {
    if (!hashOutput.textContent) return;
    try {
      await navigator.clipboard.writeText(hashOutput.textContent);
      const original = copyBtn.textContent;
      copyBtn.textContent = 'Copied!';
      setTimeout(() => { copyBtn.textContent = original; }, 1500);
    } catch {
      // Clipboard API unavailable — silently ignore.
    }
  });

  verifyBtn.addEventListener('click', async () => {
    const password = verifyPasswordInput.value;
    const hashValue = verifyHashInput.value.trim();
    if (!password || !hashValue) {
      verifyResult.textContent = 'Enter both a password and a hash.';
      verifyResult.classList.remove('error', 'success');
      return;
    }
    if (!isValidBcryptHash(hashValue)) {
      verifyResult.textContent = '✕ That doesn\'t look like a valid bcrypt hash.';
      verifyResult.classList.add('error');
      verifyResult.classList.remove('success');
      return;
    }
    verifyBtn.disabled = true;
    verifyResult.textContent = 'Verifying…';
    verifyResult.classList.remove('error', 'success');
    try {
      const matches = await verifyPassword(password, hashValue);
      const rounds = getHashRounds(hashValue);
      verifyResult.textContent = matches
        ? `✓ Match (hashed with ${rounds} salt rounds)`
        : '✕ Does not match';
      verifyResult.classList.toggle('success', matches);
      verifyResult.classList.toggle('error', !matches);
    } catch (err) {
      verifyResult.textContent = err instanceof Error ? err.message : 'Could not verify.';
      verifyResult.classList.add('error');
    } finally {
      verifyBtn.disabled = false;
    }
  });
</script>

<style>
  .bcrypt-tool {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .bcrypt-mode {
    display: flex;
    gap: var(--space-4);
    font-size: 0.9rem;
  }
  .bcrypt-mode label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
  }

  #bcrypt-hash-panel,
  #bcrypt-verify-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .bcrypt-row {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-3);
  }

  .range-input {
    width: 100%;
  }

  .mono-input {
    font-family: var(--font-mono);
  }

  .bcrypt-note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    min-height: 1.2rem;
  }
  .bcrypt-note.error { color: var(--color-danger); }
  .bcrypt-note.success { color: var(--color-success); }

  .field-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-1);
  }

  #bcrypt-hash-output {
    word-break: break-all;
    font-size: 0.9rem;
  }

  @media (max-width: 480px) {
    .bcrypt-row {
      grid-template-columns: 1fr;
    }
  }
</style>
