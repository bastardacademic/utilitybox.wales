---
---

<div class="json-tool">
  <div class="json-toolbar">
    <div class="field indent-field">
      <label class="label" for="json-indent">Indent</label>
      <select id="json-indent" class="input">
        <option value="2">2 spaces</option>
        <option value="4">4 spaces</option>
        <option value="tab">Tab</option>
      </select>
    </div>
    <div class="json-actions">
      <button type="button" id="json-format" class="btn">Format</button>
      <button type="button" id="json-minify" class="btn btn-secondary">Minify</button>
      <button type="button" id="json-copy" class="copy-btn">Copy</button>
    </div>
  </div>

  <textarea
    id="json-input"
    class="input mono-textarea"
    rows="16"
    spellcheck="false"
    placeholder={`Paste JSON here, e.g.\n{"name": "UtilityBox", "free": true}`}
  ></textarea>

  <div class="json-status" id="json-status" role="status" aria-live="polite">Waiting for input…</div>
</div>

<script>
  import { formatJson, minifyJson, validateJson } from '../../utils/json';

  const input = document.getElementById('json-input') as HTMLTextAreaElement;
  const indentSelect = document.getElementById('json-indent') as HTMLSelectElement;
  const formatBtn = document.getElementById('json-format') as HTMLButtonElement;
  const minifyBtn = document.getElementById('json-minify') as HTMLButtonElement;
  const copyBtn = document.getElementById('json-copy') as HTMLButtonElement;
  const status = document.getElementById('json-status') as HTMLElement;

  function getIndent(): number | string {
    const value = indentSelect.value;
    return value === 'tab' ? '\t' : parseInt(value, 10);
  }

  function updateStatus() {
    const text = input.value.trim();
    if (!text) {
      status.textContent = 'Waiting for input…';
      status.classList.remove('error', 'valid');
      return;
    }

    const result = validateJson(text);
    if (result.valid) {
      status.textContent = 'Valid JSON ✓';
      status.classList.remove('error');
      status.classList.add('valid');
    } else {
      const position = result.line ? ` (line ${result.line}, column ${result.column})` : '';
      status.textContent = `Invalid JSON: ${result.error}${position}`;
      status.classList.remove('valid');
      status.classList.add('error');
    }
  }

  let debounceTimer: ReturnType<typeof setTimeout>;
  input.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(updateStatus, 250);
  });

  formatBtn.addEventListener('click', () => {
    try {
      input.value = formatJson(input.value, getIndent());
      updateStatus();
    } catch {
      updateStatus();
    }
  });

  minifyBtn.addEventListener('click', () => {
    try {
      input.value = minifyJson(input.value);
      updateStatus();
    } catch {
      updateStatus();
    }
  });

  copyBtn.addEventListener('click', async () => {
    if (!input.value) return;
    try {
      await navigator.clipboard.writeText(input.value);
      const original = copyBtn.textContent;
      copyBtn.textContent = 'Copied!';
      setTimeout(() => { copyBtn.textContent = original; }, 1500);
    } catch {
      // Clipboard API unavailable — silently ignore.
    }
  });
</script>

<style>
  .json-tool {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .json-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: end;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .indent-field {
    margin-bottom: 0;
    max-width: 160px;
  }

  .json-actions {
    display: flex;
    gap: var(--space-2);
  }

  .mono-textarea {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    resize: vertical;
    min-height: 260px;
  }

  .json-status {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }
  .json-status.valid { color: var(--color-success); }
  .json-status.error { color: var(--color-danger); }

  .copy-btn {
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
    padding: 2px 10px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }
  .copy-btn:hover {
    background: var(--color-surface-alt);
    color: var(--color-text);
  }
</style>
