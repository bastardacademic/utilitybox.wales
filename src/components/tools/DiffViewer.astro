---
---

<div class="diff-tool">
  <div class="diff-inputs">
    <div class="field">
      <label class="label" for="diff-a">Original</label>
      <textarea id="diff-a" class="input mono-textarea" rows="12" spellcheck="false" placeholder="Paste the original text"></textarea>
    </div>
    <div class="field">
      <label class="label" for="diff-b">Changed</label>
      <textarea id="diff-b" class="input mono-textarea" rows="12" spellcheck="false" placeholder="Paste the changed text"></textarea>
    </div>
  </div>

  <button type="button" id="diff-compare" class="btn">Compare</button>

  <div id="diff-error" class="diff-error" hidden></div>

  <div class="field" id="diff-output-field" hidden>
    <div class="result-row">
      <span class="label" id="diff-stats">Diff</span>
      <button type="button" id="diff-copy" class="copy-btn">Copy diff</button>
    </div>
    <div class="diff-output" id="diff-output"></div>
  </div>
</div>

<script>
  import { diffLines, diffStats, DiffTooLargeError, type DiffLine } from '../../utils/diff';

  const aInput = document.getElementById('diff-a') as HTMLTextAreaElement;
  const bInput = document.getElementById('diff-b') as HTMLTextAreaElement;
  const compareBtn = document.getElementById('diff-compare') as HTMLButtonElement;
  const errorBox = document.getElementById('diff-error') as HTMLElement;
  const outputField = document.getElementById('diff-output-field') as HTMLElement;
  const output = document.getElementById('diff-output') as HTMLElement;
  const statsLabel = document.getElementById('diff-stats') as HTMLElement;
  const copyBtn = document.getElementById('diff-copy') as HTMLButtonElement;

  let lastDiffText = '';

  function escapeHtml(text: string): string {
    return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function renderLine(line: DiffLine): string {
    const marker = line.type === 'add' ? '+' : line.type === 'remove' ? '-' : ' ';
    const aNum = line.aLine ?? '';
    const bNum = line.bLine ?? '';
    return `<div class="diff-line diff-${line.type}"><span class="diff-linenum">${aNum}</span><span class="diff-linenum">${bNum}</span><span class="diff-marker">${marker}</span><span class="diff-text">${escapeHtml(line.value) || '&nbsp;'}</span></div>`;
  }

  function compare() {
    errorBox.hidden = true;
    try {
      const lines = diffLines(aInput.value, bInput.value);
      const stats = diffStats(lines);

      output.innerHTML = lines.map(renderLine).join('');
      statsLabel.textContent = `Diff — +${stats.added} / -${stats.removed} / ${stats.unchanged} unchanged`;
      outputField.hidden = false;

      lastDiffText = lines
        .map((l) => `${l.type === 'add' ? '+' : l.type === 'remove' ? '-' : ' '} ${l.value}`)
        .join('\n');
    } catch (err) {
      outputField.hidden = true;
      errorBox.textContent = err instanceof DiffTooLargeError ? err.message : 'Could not compare these inputs.';
      errorBox.hidden = false;
    }
  }

  compareBtn.addEventListener('click', compare);

  copyBtn.addEventListener('click', async () => {
    if (!lastDiffText) return;
    try {
      await navigator.clipboard.writeText(lastDiffText);
      const original = copyBtn.textContent;
      copyBtn.textContent = 'Copied!';
      setTimeout(() => { copyBtn.textContent = original; }, 1500);
    } catch {
      // Clipboard API unavailable — silently ignore.
    }
  });
</script>

<style>
  .diff-tool {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .diff-inputs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .mono-textarea {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    resize: vertical;
  }

  .diff-error {
    color: var(--color-danger);
    background: color-mix(in srgb, var(--color-danger) 10%, transparent);
    border: 1px solid var(--color-danger);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    font-size: 0.9rem;
  }

  .result-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-1);
  }
  .result-row .label { margin-bottom: 0; }

  .copy-btn {
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
    padding: 2px 10px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }
  .copy-btn:hover {
    background: var(--color-surface-alt);
    color: var(--color-text);
  }

  .diff-output {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: auto;
    max-height: 480px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .diff-output :global(.diff-line) {
    display: grid;
    grid-template-columns: 40px 40px 16px 1fr;
    gap: var(--space-2);
    padding: 1px var(--space-2);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .diff-output :global(.diff-linenum) {
    color: var(--color-text-muted);
    text-align: right;
    user-select: none;
    font-size: 0.75rem;
  }

  .diff-output :global(.diff-marker) {
    user-select: none;
    font-weight: 700;
  }

  .diff-output :global(.diff-add) {
    background: color-mix(in srgb, var(--color-success) 15%, transparent);
  }
  .diff-output :global(.diff-add .diff-marker) { color: var(--color-success); }

  .diff-output :global(.diff-remove) {
    background: color-mix(in srgb, var(--color-danger) 12%, transparent);
  }
  .diff-output :global(.diff-remove .diff-marker) { color: var(--color-danger); }

  @media (max-width: 720px) {
    .diff-inputs {
      grid-template-columns: 1fr;
    }
  }
</style>
