---
const FORMATS = [
  { id: 'json', label: 'JSON' },
  { id: 'yaml', label: 'YAML' },
  { id: 'xml', label: 'XML' },
  { id: 'csv', label: 'CSV' }
];
---

<div class="convert-tool">
  <div class="convert-row">
    <div class="field">
      <label class="label" for="convert-from">From</label>
      <select id="convert-from" class="input">
        {FORMATS.map((f) => <option value={f.id} selected={f.id === 'json'}>{f.label}</option>)}
      </select>
    </div>
    <button type="button" id="convert-swap" class="btn btn-secondary" aria-label="Swap formats">⇄ Swap</button>
    <div class="field">
      <label class="label" for="convert-to">To</label>
      <select id="convert-to" class="input">
        {FORMATS.map((f) => <option value={f.id} selected={f.id === 'yaml'}>{f.label}</option>)}
      </select>
    </div>
  </div>

  <div class="field">
    <div class="field-header">
      <label class="label" for="convert-input">Input</label>
      <button type="button" class="copy-btn" id="convert-example">Load example</button>
    </div>
    <textarea id="convert-input" class="input mono-textarea" rows="10" spellcheck="false" placeholder="Paste data here"></textarea>
  </div>

  <div class="field">
    <div class="field-header">
      <span class="label">Output</span>
      <button type="button" class="copy-btn" id="convert-copy">Copy</button>
    </div>
    <textarea id="convert-output" class="input mono-textarea" rows="10" readonly spellcheck="false"></textarea>
  </div>
</div>

<script>
  import { parseData, serializeData, type DataFormat } from '../../utils/dataConvert';

  const fromSelect = document.getElementById('convert-from') as HTMLSelectElement;
  const toSelect = document.getElementById('convert-to') as HTMLSelectElement;
  const swapBtn = document.getElementById('convert-swap') as HTMLButtonElement;
  const input = document.getElementById('convert-input') as HTMLTextAreaElement;
  const output = document.getElementById('convert-output') as HTMLTextAreaElement;
  const copyBtn = document.getElementById('convert-copy') as HTMLButtonElement;
  const exampleBtn = document.getElementById('convert-example') as HTMLButtonElement;

  const EXAMPLE = {
    name: 'Ada Lovelace',
    born: 1815,
    active: true,
    tags: ['mathematician', 'writer'],
    address: { city: 'London', country: 'UK' }
  };

  function convert() {
    const text = input.value.trim();
    if (!text) {
      output.value = '';
      output.classList.remove('error');
      return;
    }
    try {
      const from = fromSelect.value as DataFormat;
      const to = toSelect.value as DataFormat;
      const value = parseData(text, from);
      output.value = serializeData(value, to);
      output.classList.remove('error');
    } catch (err) {
      output.value = err instanceof Error ? err.message : 'Could not convert — check the input is valid.';
      output.classList.add('error');
    }
  }

  input.addEventListener('input', convert);
  fromSelect.addEventListener('change', convert);
  toSelect.addEventListener('change', convert);

  swapBtn.addEventListener('click', () => {
    const fromValue = fromSelect.value;
    fromSelect.value = toSelect.value;
    toSelect.value = fromValue;
    if (output.value && !output.classList.contains('error')) {
      input.value = output.value;
    }
    convert();
  });

  exampleBtn.addEventListener('click', () => {
    fromSelect.value = 'json';
    input.value = JSON.stringify(EXAMPLE, null, 2);
    convert();
  });

  copyBtn.addEventListener('click', async () => {
    if (!output.value) return;
    try {
      await navigator.clipboard.writeText(output.value);
      const original = copyBtn.textContent;
      copyBtn.textContent = 'Copied!';
      setTimeout(() => { copyBtn.textContent = original; }, 1500);
    } catch {
      // Clipboard API unavailable — silently ignore.
    }
  });
</script>

<style>
  .convert-tool {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .convert-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-3);
    align-items: end;
  }

  .field-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-1);
  }

  .mono-textarea {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    resize: vertical;
  }

  #convert-output.error {
    color: var(--color-danger);
  }

  @media (max-width: 480px) {
    .convert-row {
      grid-template-columns: 1fr;
    }
  }
</style>
