---
---

<div class="ana-tool">
  <div class="ana-row">
    <div class="field">
      <label class="label" for="ana-word1">First word or phrase</label>
      <input id="ana-word1" class="input" type="text" spellcheck="false" placeholder="listen" />
    </div>
    <div class="field">
      <label class="label" for="ana-word2">Second word or phrase</label>
      <input id="ana-word2" class="input" type="text" spellcheck="false" placeholder="silent" />
    </div>
  </div>

  <div class="result-box" id="ana-result" role="status" aria-live="polite">Enter two words to compare.</div>
</div>

<script>
  import { isAnagramOf } from '../../utils/words';

  const word1Input = document.getElementById('ana-word1') as HTMLInputElement;
  const word2Input = document.getElementById('ana-word2') as HTMLInputElement;
  const result = document.getElementById('ana-result') as HTMLElement;

  function normalize(text: string): string {
    return text.toLowerCase().replace(/[^a-z0-9]/g, '');
  }

  function update() {
    const w1 = word1Input.value;
    const w2 = word2Input.value;

    if (!w1.trim() || !w2.trim()) {
      result.textContent = 'Enter two words to compare.';
      result.classList.remove('ana-yes', 'ana-no');
      return;
    }

    const match = isAnagramOf(normalize(w1), normalize(w2));
    result.textContent = match
      ? `Yes — "${w1}" and "${w2}" are anagrams of each other.`
      : `No — "${w1}" and "${w2}" are not anagrams of each other.`;
    result.classList.toggle('ana-yes', match);
    result.classList.toggle('ana-no', !match);
  }

  word1Input.addEventListener('input', update);
  word2Input.addEventListener('input', update);
</script>

<style>
  .ana-tool {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .ana-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .ana-yes { color: var(--color-success); }
  .ana-no { color: var(--color-text-muted); }

  @media (max-width: 480px) {
    .ana-row { grid-template-columns: 1fr; }
  }
</style>
