---
import { SIZE_UNITS, SPEED_UNITS } from '../../utils/bandwidth';
---

<div class="bw-calc">
  <div class="bw-row">
    <div class="field">
      <label class="label" for="bw-size">File size</label>
      <input id="bw-size" class="input" type="number" value="1" min="0" step="any" />
    </div>
    <div class="field">
      <label class="label" for="bw-size-unit">&nbsp;</label>
      <select id="bw-size-unit" class="input">
        {Object.entries(SIZE_UNITS).map(([key, u]) => (
          <option value={key} selected={key === 'gb'}>{u.label}</option>
        ))}
      </select>
    </div>
  </div>

  <div class="bw-row">
    <div class="field">
      <label class="label" for="bw-speed">Connection speed</label>
      <input id="bw-speed" class="input" type="number" value="100" min="0" step="any" />
    </div>
    <div class="field">
      <label class="label" for="bw-speed-unit">&nbsp;</label>
      <select id="bw-speed-unit" class="input">
        {Object.entries(SPEED_UNITS).map(([key, u]) => (
          <option value={key} selected={key === 'mbps'}>{u.label}</option>
        ))}
      </select>
    </div>
  </div>

  <button type="button" id="bw-calculate" class="btn">Calculate</button>

  <div class="field" style="margin-top: var(--space-4)">
    <div class="result-row">
      <span class="label">Estimated transfer time</span>
      <span class="result-actions">
        <button type="button" id="bw-share" class="copy-btn">🔗 Share</button>
        <button type="button" id="bw-copy" class="copy-btn">Copy</button>
      </span>
    </div>
    <div class="result-box" id="bw-result" role="status" aria-live="polite">Enter a size and speed, then press Calculate</div>
  </div>

  <p class="bw-note">Network speeds are decimal (1 Mbps = 1,000,000 bits/second, as ISPs advertise); file sizes are binary (1 GB = 1024 MB). Real-world transfers are usually slower than this due to protocol overhead.</p>
</div>

<script>
  import { calculateTransferSeconds, formatDuration, BandwidthError, type SizeUnit, type SpeedUnit } from '../../utils/bandwidth';
  import { getShareParams, copyShareLink } from '../../utils/shareLink';

  const sizeInput = document.getElementById('bw-size') as HTMLInputElement;
  const sizeUnitSelect = document.getElementById('bw-size-unit') as HTMLSelectElement;
  const speedInput = document.getElementById('bw-speed') as HTMLInputElement;
  const speedUnitSelect = document.getElementById('bw-speed-unit') as HTMLSelectElement;
  const calculateBtn = document.getElementById('bw-calculate') as HTMLButtonElement;
  const resultBox = document.getElementById('bw-result') as HTMLElement;
  const copyBtn = document.getElementById('bw-copy') as HTMLButtonElement;

  function calculate() {
    resultBox.removeAttribute('data-valid');
    try {
      const seconds = calculateTransferSeconds(
        parseFloat(sizeInput.value),
        sizeUnitSelect.value as SizeUnit,
        parseFloat(speedInput.value),
        speedUnitSelect.value as SpeedUnit
      );
      resultBox.textContent = formatDuration(seconds);
      resultBox.classList.remove('error');
      resultBox.setAttribute('data-valid', 'true');
    } catch (err) {
      resultBox.textContent = err instanceof BandwidthError ? err.message : 'Could not calculate transfer time';
      resultBox.classList.add('error');
    }
  }

  calculateBtn.addEventListener('click', calculate);
  [sizeInput, speedInput].forEach((el) => el.addEventListener('keydown', (e) => { if (e.key === 'Enter') calculate(); }));

  copyBtn.addEventListener('click', async () => {
    if (resultBox.getAttribute('data-valid') !== 'true' || !resultBox.textContent) return;
    try {
      await navigator.clipboard.writeText(resultBox.textContent);
      const original = copyBtn.textContent;
      copyBtn.textContent = 'Copied!';
      setTimeout(() => { copyBtn.textContent = original; }, 1500);
    } catch {
      // Clipboard API unavailable — silently ignore.
    }
  });

  const shareBtn = document.getElementById('bw-share') as HTMLButtonElement;
  shareBtn.addEventListener('click', () => {
    copyShareLink(
      { size: sizeInput.value, sizeUnit: sizeUnitSelect.value, speed: speedInput.value, speedUnit: speedUnitSelect.value },
      shareBtn
    );
  });

  // Pre-fill from a shared link, e.g. ?size=1&sizeUnit=gb&speed=100&speedUnit=mbps
  (function restoreFromShareLink() {
    const params = getShareParams();
    const size = params.get('size');
    const sizeUnit = params.get('sizeUnit');
    const speed = params.get('speed');
    const speedUnit = params.get('speedUnit');
    let shouldCalculate = false;

    if (size) { sizeInput.value = size; shouldCalculate = true; }
    if (sizeUnit && [...sizeUnitSelect.options].some((o) => o.value === sizeUnit)) { sizeUnitSelect.value = sizeUnit; shouldCalculate = true; }
    if (speed) { speedInput.value = speed; shouldCalculate = true; }
    if (speedUnit && [...speedUnitSelect.options].some((o) => o.value === speedUnit)) { speedUnitSelect.value = speedUnit; shouldCalculate = true; }

    if (shouldCalculate) calculate();
  })();
</script>

<style>
  .bw-calc {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .bw-row {
    display: flex;
    gap: var(--space-3);
    align-items: end;
  }
  .bw-row .field:first-child { flex: 1; }
  .bw-row .field:last-child { flex: 0 0 100px; }

  .result-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-1);
  }
  .result-row .label { margin-bottom: 0; }

  .result-actions {
    display: flex;
    gap: var(--space-2);
  }

  .copy-btn {
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
    padding: 2px 10px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }
  .copy-btn:hover {
    background: var(--color-surface-alt);
    color: var(--color-text);
  }

  #bw-result.error {
    color: var(--color-danger);
  }

  .bw-note {
    margin-top: var(--space-2);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 480px) {
    .bw-row .field:last-child { flex-basis: 120px; }
  }
</style>
