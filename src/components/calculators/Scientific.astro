---
---

<div class="sci-calc">
  <div class="field">
    <label class="label" for="sci-expression">Expression</label>
    <input
      id="sci-expression"
      class="input sci-display"
      type="text"
      inputmode="text"
      autocomplete="off"
      spellcheck="false"
      placeholder="e.g. sin(pi/2) + sqrt(16)"
    />
  </div>

  <div class="sci-mode">
    <label>
      <input type="radio" name="angle-mode" value="deg" checked /> Degrees
    </label>
    <label>
      <input type="radio" name="angle-mode" value="rad" /> Radians
    </label>
  </div>

  <div class="sci-keypad" id="sci-keypad">
    <button type="button" data-key="(">(</button>
    <button type="button" data-key=")">)</button>
    <button type="button" data-key="%">%</button>
    <button type="button" data-action="clear" class="key-danger">C</button>
    <button type="button" data-action="backspace">⌫</button>

    <button type="button" data-key="sin(">sin</button>
    <button type="button" data-key="cos(">cos</button>
    <button type="button" data-key="tan(">tan</button>
    <button type="button" data-key="^">x^y</button>
    <button type="button" data-key="sqrt(">√</button>

    <button type="button" data-key="7">7</button>
    <button type="button" data-key="8">8</button>
    <button type="button" data-key="9">9</button>
    <button type="button" data-key="/">÷</button>
    <button type="button" data-key="log(">log</button>

    <button type="button" data-key="4">4</button>
    <button type="button" data-key="5">5</button>
    <button type="button" data-key="6">6</button>
    <button type="button" data-key="*">×</button>
    <button type="button" data-key="ln(">ln</button>

    <button type="button" data-key="1">1</button>
    <button type="button" data-key="2">2</button>
    <button type="button" data-key="3">3</button>
    <button type="button" data-key="-">−</button>
    <button type="button" data-key="pi">π</button>

    <button type="button" data-key="0">0</button>
    <button type="button" data-key=".">.</button>
    <button type="button" data-action="equals" class="key-primary">=</button>
    <button type="button" data-key="+">+</button>
    <button type="button" data-key="e">e</button>
  </div>

  <div class="field">
    <div class="result-row">
      <span class="label">Result</span>
      <span class="result-actions">
        <button type="button" id="sci-share" class="copy-btn">🔗 Share</button>
        <button type="button" id="sci-copy" class="copy-btn">Copy</button>
      </span>
    </div>
    <div class="result-box" id="sci-result" role="status" aria-live="polite">0</div>
  </div>

  <div class="sci-history" id="sci-history" aria-label="Calculation history"></div>
</div>

<script>
  import { evaluateExpression, degreesToRadians, CalculatorError } from '../../utils/calculators';
  import { getShareParams, copyShareLink } from '../../utils/shareLink';

  const expressionInput = document.getElementById('sci-expression') as HTMLInputElement;
  const resultBox = document.getElementById('sci-result') as HTMLElement;
  const keypad = document.getElementById('sci-keypad') as HTMLElement;
  const historyBox = document.getElementById('sci-history') as HTMLElement;
  const angleRadios = document.querySelectorAll<HTMLInputElement>('input[name="angle-mode"]');

  const history: string[] = [];

  function getAngleMode(): 'deg' | 'rad' {
    const checked = document.querySelector<HTMLInputElement>('input[name="angle-mode"]:checked');
    return (checked?.value as 'deg' | 'rad') ?? 'deg';
  }

  function prepareForEvaluation(expression: string): string {
    if (getAngleMode() === 'rad') return expression;
    // Wrap trig function arguments with a degrees-to-radians conversion.
    return expression.replace(/(sin|cos|tan)\(([^)]*)\)/g, (_match, fn, arg) => {
      try {
        const value = evaluateExpression(arg);
        return `${fn}(${degreesToRadians(value)})`;
      } catch {
        return `${fn}(${arg})`;
      }
    });
  }

  function renderHistory() {
    historyBox.innerHTML = history
      .slice(-5)
      .reverse()
      .map((entry) => `<div class="history-entry">${entry}</div>`)
      .join('');
  }

  function calculate() {
    const raw = expressionInput.value.trim();
    if (!raw) return;
    try {
      const prepared = prepareForEvaluation(raw);
      const result = evaluateExpression(prepared);
      const formatted = Number(result.toFixed(10)).toString();
      resultBox.textContent = formatted;
      resultBox.classList.remove('error');
      history.push(`${raw} = ${formatted}`);
      renderHistory();
    } catch (err) {
      resultBox.textContent = err instanceof CalculatorError ? err.message : 'Invalid expression';
      resultBox.classList.add('error');
    }
  }

  keypad.addEventListener('click', (event) => {
    const target = (event.target as HTMLElement).closest('button');
    if (!target) return;

    const key = target.getAttribute('data-key');
    const action = target.getAttribute('data-action');

    if (key !== null) {
      expressionInput.value += key;
      expressionInput.focus();
      return;
    }

    if (action === 'clear') {
      expressionInput.value = '';
      resultBox.textContent = '0';
      resultBox.classList.remove('error');
    } else if (action === 'backspace') {
      expressionInput.value = expressionInput.value.slice(0, -1);
    } else if (action === 'equals') {
      calculate();
    }
  });

  expressionInput.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      event.preventDefault();
      calculate();
    }
  });

  angleRadios.forEach((radio) => radio.addEventListener('change', () => {
    if (expressionInput.value.trim()) calculate();
  }));

  const copyBtn = document.getElementById('sci-copy') as HTMLButtonElement;
  copyBtn.addEventListener('click', async () => {
    if (!resultBox.textContent || resultBox.classList.contains('error')) return;
    try {
      await navigator.clipboard.writeText(resultBox.textContent);
      const original = copyBtn.textContent;
      copyBtn.textContent = 'Copied!';
      setTimeout(() => { copyBtn.textContent = original; }, 1500);
    } catch {
      // Clipboard API unavailable — silently ignore.
    }
  });

  const shareBtn = document.getElementById('sci-share') as HTMLButtonElement;
  shareBtn.addEventListener('click', () => {
    copyShareLink({ expr: expressionInput.value, angle: getAngleMode() }, shareBtn);
  });

  // Pre-fill from a shared link, e.g. ?expr=sin(pi/2)&angle=rad
  (function restoreFromShareLink() {
    const params = getShareParams();
    const expr = params.get('expr');
    const angle = params.get('angle');

    if (angle === 'deg' || angle === 'rad') {
      const radio = document.querySelector<HTMLInputElement>(`input[name="angle-mode"][value="${angle}"]`);
      if (radio) radio.checked = true;
    }

    if (expr) {
      expressionInput.value = expr;
      calculate();
    }
  })();
</script>

<style>
  .sci-calc {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .sci-display {
    font-family: var(--font-mono);
    font-size: 1.1rem;
  }

  .result-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-1);
  }
  .result-row .label { margin-bottom: 0; }

  .result-actions {
    display: flex;
    gap: var(--space-2);
  }

  .copy-btn {
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
    padding: 2px 10px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }
  .copy-btn:hover {
    background: var(--color-surface-alt);
    color: var(--color-text);
  }

  .sci-mode {
    display: flex;
    gap: var(--space-5);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .sci-mode label {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    cursor: pointer;
  }

  .sci-keypad {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-2);
  }

  .sci-keypad button {
    padding: var(--space-3) var(--space-2);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface-alt);
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.1s ease;
  }
  .sci-keypad button:hover { background: var(--color-border); }

  .key-primary {
    background: var(--color-primary) !important;
    color: var(--color-primary-contrast) !important;
    border-color: var(--color-primary) !important;
  }
  .key-primary:hover { background: var(--color-primary-hover) !important; }

  .key-danger {
    color: var(--color-danger) !important;
  }

  #sci-result.error {
    color: var(--color-danger);
  }

  .sci-history {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  @media (max-width: 480px) {
    .sci-keypad { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--space-1); }
    .sci-keypad button { padding: var(--space-2) var(--space-1); font-size: 0.85rem; }
  }
</style>
