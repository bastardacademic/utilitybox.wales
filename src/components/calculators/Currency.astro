---
// Every currency Frankfurter/the ECB publishes a reference rate for.
const CURRENCIES = [
  { code: 'AUD', name: 'Australian Dollar' },
  { code: 'BRL', name: 'Brazilian Real' },
  { code: 'CAD', name: 'Canadian Dollar' },
  { code: 'CHF', name: 'Swiss Franc' },
  { code: 'CNY', name: 'Chinese Renminbi Yuan' },
  { code: 'CZK', name: 'Czech Koruna' },
  { code: 'DKK', name: 'Danish Krone' },
  { code: 'EUR', name: 'Euro' },
  { code: 'GBP', name: 'British Pound' },
  { code: 'HKD', name: 'Hong Kong Dollar' },
  { code: 'HUF', name: 'Hungarian Forint' },
  { code: 'IDR', name: 'Indonesian Rupiah' },
  { code: 'ILS', name: 'Israeli New Shekel' },
  { code: 'INR', name: 'Indian Rupee' },
  { code: 'ISK', name: 'Icelandic Króna' },
  { code: 'JPY', name: 'Japanese Yen' },
  { code: 'KRW', name: 'South Korean Won' },
  { code: 'MXN', name: 'Mexican Peso' },
  { code: 'MYR', name: 'Malaysian Ringgit' },
  { code: 'NOK', name: 'Norwegian Krone' },
  { code: 'NZD', name: 'New Zealand Dollar' },
  { code: 'PHP', name: 'Philippine Peso' },
  { code: 'PLN', name: 'Polish Złoty' },
  { code: 'RON', name: 'Romanian Leu' },
  { code: 'SEK', name: 'Swedish Krona' },
  { code: 'SGD', name: 'Singapore Dollar' },
  { code: 'THB', name: 'Thai Baht' },
  { code: 'TRY', name: 'Turkish Lira' },
  { code: 'USD', name: 'United States Dollar' },
  { code: 'ZAR', name: 'South African Rand' }
];
---

<div class="currency-calc">
  <div class="currency-row">
    <div class="field">
      <label class="label" for="cur-amount">Amount</label>
      <input id="cur-amount" class="input" type="number" value="1" min="0" step="any" />
    </div>
    <div class="field">
      <label class="label" for="cur-from">From</label>
      <select id="cur-from" class="input">
        {CURRENCIES.map((c) => (
          <option value={c.code} selected={c.code === 'GBP'}>{c.code} — {c.name}</option>
        ))}
      </select>
    </div>
    <button type="button" id="cur-swap" class="btn btn-secondary" aria-label="Swap currencies">⇄</button>
    <div class="field">
      <label class="label" for="cur-to">To</label>
      <select id="cur-to" class="input">
        {CURRENCIES.map((c) => (
          <option value={c.code} selected={c.code === 'USD'}>{c.code} — {c.name}</option>
        ))}
      </select>
    </div>
  </div>

  <button type="button" id="cur-convert" class="btn">Convert</button>

  <div class="field" style="margin-top: var(--space-4)">
    <div class="result-row">
      <span class="label">Result</span>
      <span class="result-actions">
        <button type="button" id="cur-share" class="copy-btn">🔗 Share</button>
        <button type="button" id="cur-copy" class="copy-btn">Copy</button>
      </span>
    </div>
    <div class="result-box" id="cur-result" role="status" aria-live="polite">Enter an amount and press Convert</div>
  </div>

  <p class="cur-note" id="cur-rate-note"></p>
</div>

<script>
  import { getShareParams, copyShareLink } from '../../utils/shareLink';

  const amountInput = document.getElementById('cur-amount') as HTMLInputElement;
  const fromSelect = document.getElementById('cur-from') as HTMLSelectElement;
  const toSelect = document.getElementById('cur-to') as HTMLSelectElement;
  const swapBtn = document.getElementById('cur-swap') as HTMLButtonElement;
  const convertBtn = document.getElementById('cur-convert') as HTMLButtonElement;
  const resultBox = document.getElementById('cur-result') as HTMLElement;
  const rateNote = document.getElementById('cur-rate-note') as HTMLElement;
  const copyBtn = document.getElementById('cur-copy') as HTMLButtonElement;

  async function convert() {
    const amount = parseFloat(amountInput.value);
    const from = fromSelect.value;
    const to = toSelect.value;

    resultBox.removeAttribute('data-valid');

    if (Number.isNaN(amount)) {
      resultBox.textContent = 'Enter a valid amount';
      resultBox.classList.add('error');
      return;
    }

    if (from === to) {
      resultBox.textContent = `${amount.toFixed(2)} ${from} = ${amount.toFixed(2)} ${to}`;
      resultBox.classList.remove('error');
      resultBox.setAttribute('data-valid', 'true');
      rateNote.textContent = 'Same currency selected.';
      return;
    }

    resultBox.textContent = 'Fetching latest rates…';
    resultBox.classList.remove('error');

    try {
      const response = await fetch(`https://api.frankfurter.app/latest?amount=${amount}&from=${from}&to=${to}`);
      if (!response.ok) throw new Error('Rate lookup failed');
      const data = await response.json();
      const converted = data.rates?.[to];

      if (typeof converted !== 'number') throw new Error('Rate unavailable for this pair');

      resultBox.textContent = `${amount.toLocaleString()} ${from} = ${converted.toLocaleString(undefined, { maximumFractionDigits: 4 })} ${to}`;
      resultBox.setAttribute('data-valid', 'true');
      rateNote.textContent = `1 ${from} = ${(converted / amount).toFixed(6)} ${to} · rates from Frankfurter (ECB), as of ${data.date}`;
    } catch (err) {
      resultBox.textContent = 'Could not fetch exchange rates. Please try again.';
      resultBox.classList.add('error');
      rateNote.textContent = '';
    }
  }

  copyBtn.addEventListener('click', async () => {
    if (resultBox.getAttribute('data-valid') !== 'true' || !resultBox.textContent) return;
    try {
      await navigator.clipboard.writeText(resultBox.textContent);
      const original = copyBtn.textContent;
      copyBtn.textContent = 'Copied!';
      setTimeout(() => { copyBtn.textContent = original; }, 1500);
    } catch {
      // Clipboard API unavailable — silently ignore.
    }
  });

  swapBtn.addEventListener('click', () => {
    const temp = fromSelect.value;
    fromSelect.value = toSelect.value;
    toSelect.value = temp;
    convert();
  });

  convertBtn.addEventListener('click', convert);
  amountInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') convert();
  });

  const shareBtn = document.getElementById('cur-share') as HTMLButtonElement;
  shareBtn.addEventListener('click', () => {
    copyShareLink({ amount: amountInput.value, from: fromSelect.value, to: toSelect.value }, shareBtn);
  });

  // Pre-fill from a shared link, e.g. ?amount=100&from=GBP&to=USD
  (function restoreFromShareLink() {
    const params = getShareParams();
    const amount = params.get('amount');
    const from = params.get('from');
    const to = params.get('to');
    let shouldConvert = false;

    if (amount) { amountInput.value = amount; shouldConvert = true; }
    if (from && [...fromSelect.options].some((o) => o.value === from)) { fromSelect.value = from; shouldConvert = true; }
    if (to && [...toSelect.options].some((o) => o.value === to)) { toSelect.value = to; shouldConvert = true; }

    if (shouldConvert) convert();
  })();
</script>

<style>
  .result-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-1);
  }
  .result-row .label { margin-bottom: 0; }

  .result-actions {
    display: flex;
    gap: var(--space-2);
  }

  .copy-btn {
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
    padding: 2px 10px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }
  .copy-btn:hover {
    background: var(--color-surface-alt);
    color: var(--color-text);
  }

  .currency-row {
    display: grid;
    grid-template-columns: 1fr 1fr auto 1fr;
    gap: var(--space-3);
    align-items: end;
  }

  #cur-swap {
    margin-bottom: 4px;
  }

  .cur-note {
    margin-top: var(--space-2);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  #cur-result.error {
    color: var(--color-danger);
  }

  @media (max-width: 640px) {
    .currency-row {
      grid-template-columns: 1fr;
    }
    #cur-swap {
      justify-self: center;
      transform: rotate(90deg);
    }
  }
</style>
