---
---

<div class="net-calc">
  <div class="field">
    <label class="label" for="net-cidr">IP address with CIDR prefix</label>
    <input
      id="net-cidr"
      class="input"
      type="text"
      value="192.168.1.0/24"
      autocomplete="off"
      spellcheck="false"
      placeholder="e.g. 192.168.1.0/24"
    />
  </div>

  <button type="button" id="net-calculate" class="btn">Calculate</button>

  <div class="net-results" id="net-results" hidden>
    <div class="result-row">
      <span class="label">Results</span>
      <span class="result-actions">
        <button type="button" id="net-share" class="copy-btn">🔗 Share</button>
        <button type="button" id="net-copy" class="copy-btn">Copy summary</button>
      </span>
    </div>
    <table>
      <tbody>
        <tr><td>Network address</td><td id="r-network" class="num"></td></tr>
        <tr><td>Broadcast address</td><td id="r-broadcast" class="num"></td></tr>
        <tr><td>Subnet mask</td><td id="r-mask" class="num"></td></tr>
        <tr><td>Wildcard mask</td><td id="r-wildcard" class="num"></td></tr>
        <tr><td>First usable host</td><td id="r-first" class="num"></td></tr>
        <tr><td>Last usable host</td><td id="r-last" class="num"></td></tr>
        <tr><td>Total addresses</td><td id="r-total" class="num"></td></tr>
        <tr><td>Usable hosts</td><td id="r-usable" class="num"></td></tr>
        <tr><td>IP class</td><td id="r-class" class="num"></td></tr>
        <tr><td>Address type</td><td id="r-private" class="num"></td></tr>
      </tbody>
    </table>

    <div class="net-binary">
      <span class="label">Network address (binary)</span>
      <code id="r-binary-network"></code>
      <span class="label">Subnet mask (binary)</span>
      <code id="r-binary-mask"></code>
    </div>
  </div>

  <div class="field" id="net-error" hidden></div>

  <hr class="net-divider" />

  <div class="net-split">
    <h3>Split into subnets</h3>
    <div class="net-split-row">
      <div class="field">
        <label class="label" for="net-split-count">Number of subnets</label>
        <input id="net-split-count" class="input" type="number" min="2" max="256" value="4" />
      </div>
      <button type="button" id="net-split-btn" class="btn btn-secondary">Split</button>
    </div>
    <div class="net-split-results" id="net-split-results"></div>
  </div>
</div>

<script>
  import { calculateCidr, splitSubnet, NetworkError } from '../../utils/network';
  import { getShareParams, copyShareLink } from '../../utils/shareLink';

  const cidrInput = document.getElementById('net-cidr') as HTMLInputElement;
  const calculateBtn = document.getElementById('net-calculate') as HTMLButtonElement;
  const resultsBox = document.getElementById('net-results') as HTMLElement;
  const errorBox = document.getElementById('net-error') as HTMLElement;

  const splitCountInput = document.getElementById('net-split-count') as HTMLInputElement;
  const splitBtn = document.getElementById('net-split-btn') as HTMLButtonElement;
  const splitResults = document.getElementById('net-split-results') as HTMLElement;
  const copyBtn = document.getElementById('net-copy') as HTMLButtonElement;

  let lastSummary = '';

  function setText(id: string, value: string) {
    (document.getElementById(id) as HTMLElement).textContent = value;
  }

  function calculate() {
    errorBox.hidden = true;
    try {
      const info = calculateCidr(cidrInput.value);
      setText('r-network', `${info.networkAddress}`);
      setText('r-broadcast', info.broadcastAddress);
      setText('r-mask', `${info.subnetMask} (/${info.prefix})`);
      setText('r-wildcard', info.wildcardMask);
      setText('r-first', info.firstHost);
      setText('r-last', info.lastHost);
      setText('r-total', info.totalHosts.toLocaleString());
      setText('r-usable', info.usableHosts.toLocaleString());
      setText('r-class', info.ipClass);
      setText('r-private', info.isPrivate ? 'Private' : 'Public');
      setText('r-binary-network', info.binaryNetwork);
      setText('r-binary-mask', info.binaryMask);
      resultsBox.hidden = false;

      lastSummary = [
        `CIDR: ${info.ip}/${info.prefix}`,
        `Network address: ${info.networkAddress}`,
        `Broadcast address: ${info.broadcastAddress}`,
        `Subnet mask: ${info.subnetMask} (/${info.prefix})`,
        `Wildcard mask: ${info.wildcardMask}`,
        `First usable host: ${info.firstHost}`,
        `Last usable host: ${info.lastHost}`,
        `Total addresses: ${info.totalHosts}`,
        `Usable hosts: ${info.usableHosts}`,
        `IP class: ${info.ipClass}`,
        `Address type: ${info.isPrivate ? 'Private' : 'Public'}`
      ].join('\n');
    } catch (err) {
      resultsBox.hidden = true;
      errorBox.textContent = err instanceof NetworkError ? err.message : 'Invalid CIDR notation';
      errorBox.hidden = false;
    }
  }

  function performSplit() {
    const count = parseInt(splitCountInput.value, 10);
    try {
      const subnets = splitSubnet(cidrInput.value, count);
      splitResults.innerHTML = `
        <table>
          <thead><tr><th>#</th><th>Network</th><th>Range</th><th>Usable hosts</th></tr></thead>
          <tbody>
            ${subnets
              .map(
                (s, i) =>
                  `<tr><td>${i + 1}</td><td>${s.networkAddress}/${s.prefix}</td><td>${s.firstHost} – ${s.lastHost}</td><td>${s.usableHosts}</td></tr>`
              )
              .join('')}
          </tbody>
        </table>
      `;
    } catch (err) {
      splitResults.innerHTML = `<p class="net-split-error">${err instanceof Error ? err.message : 'Could not split subnet'}</p>`;
    }
  }

  calculateBtn.addEventListener('click', calculate);
  cidrInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') calculate(); });
  splitBtn.addEventListener('click', performSplit);

  copyBtn.addEventListener('click', async () => {
    if (!lastSummary) return;
    try {
      await navigator.clipboard.writeText(lastSummary);
      const original = copyBtn.textContent;
      copyBtn.textContent = 'Copied!';
      setTimeout(() => { copyBtn.textContent = original; }, 1500);
    } catch {
      // Clipboard API unavailable — silently ignore.
    }
  });

  const shareBtn = document.getElementById('net-share') as HTMLButtonElement;
  shareBtn.addEventListener('click', () => {
    copyShareLink({ cidr: cidrInput.value }, shareBtn);
  });

  // Pre-fill from a shared link, e.g. ?cidr=10.0.0.0/8
  const sharedCidr = getShareParams().get('cidr');
  if (sharedCidr) cidrInput.value = sharedCidr;

  calculate();
</script>

<style>
  .net-calc {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  td.num { text-align: right; font-family: var(--font-mono); }

  .result-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }
  .result-row .label { margin-bottom: 0; }

  .result-actions {
    display: flex;
    gap: var(--space-2);
  }

  .copy-btn {
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
    padding: 2px 10px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }
  .copy-btn:hover {
    background: var(--color-surface-alt);
    color: var(--color-text);
  }

  #net-error {
    color: var(--color-danger);
    background: color-mix(in srgb, var(--color-danger) 10%, transparent);
    border: 1px solid var(--color-danger);
    border-radius: var(--radius-md);
    padding: var(--space-3);
  }

  .net-binary {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .net-binary code {
    display: block;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-2);
    margin-bottom: var(--space-2);
    word-break: break-all;
  }

  .net-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-2) 0;
  }

  .net-split-row {
    display: flex;
    gap: var(--space-3);
    align-items: end;
  }
  .net-split-row .field { flex: 1; max-width: 200px; }

  .net-split-results {
    margin-top: var(--space-3);
    overflow-x: auto;
  }

  .net-split-error {
    color: var(--color-danger);
  }

  @media (max-width: 480px) {
    .net-split-row { flex-wrap: wrap; }
    .net-split-row .field { max-width: none; flex-basis: 100%; }
  }
</style>
