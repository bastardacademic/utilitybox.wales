---
---

<div class="salary-calc">
  <div class="salary-grid">
    <div class="field">
      <label class="label" for="salary-gross">Gross annual salary (£)</label>
      <input id="salary-gross" class="input" type="number" min="0" step="any" value="35000" />
    </div>

    <div class="field">
      <label class="label" for="salary-pension">Pension contribution (%)</label>
      <input id="salary-pension" class="input" type="number" min="0" max="100" step="0.5" value="0" />
    </div>

    <div class="field">
      <label class="label" for="salary-loan">Student loan plan</label>
      <select id="salary-loan" class="input">
        <option value="none">None</option>
        <option value="plan1">Plan 1</option>
        <option value="plan2">Plan 2</option>
        <option value="plan4">Plan 4 (Scotland)</option>
        <option value="postgrad">Postgraduate loan</option>
      </select>
    </div>

    <div class="field">
      <label class="label" for="salary-region">Tax region</label>
      <select id="salary-region" class="input">
        <option value="rest-of-uk">England / Wales / Northern Ireland</option>
        <option value="scotland">Scotland</option>
      </select>
    </div>
  </div>

  <button type="button" id="salary-calculate" class="btn">Calculate</button>

  <div class="salary-results" id="salary-results" hidden>
    <div class="result-row">
      <span class="label">Summary</span>
      <span class="result-actions">
        <button type="button" id="salary-share" class="copy-btn">🔗 Share</button>
        <button type="button" id="salary-copy" class="copy-btn">Copy summary</button>
      </span>
    </div>
    <div class="salary-summary">
      <div class="summary-item">
        <span class="label">Take-home pay (annual)</span>
        <strong id="net-annual">—</strong>
      </div>
      <div class="summary-item">
        <span class="label">Take-home pay (monthly)</span>
        <strong id="net-monthly">—</strong>
      </div>
      <div class="summary-item">
        <span class="label">Take-home pay (weekly)</span>
        <strong id="net-weekly">—</strong>
      </div>
    </div>

    <table>
      <tbody>
        <tr><td>Personal allowance</td><td id="row-allowance" class="num"></td></tr>
        <tr><td>Taxable income</td><td id="row-taxable" class="num"></td></tr>
        <tr><td>Income tax</td><td id="row-tax" class="num"></td></tr>
        <tr><td>National Insurance</td><td id="row-ni" class="num"></td></tr>
        <tr><td>Student loan repayment</td><td id="row-loan" class="num"></td></tr>
        <tr><td>Pension contribution</td><td id="row-pension" class="num"></td></tr>
        <tr><td><strong>Effective tax rate (tax + NI)</strong></td><td id="row-rate" class="num"></td></tr>
      </tbody>
    </table>

    <h3>Income tax band breakdown</h3>
    <table id="salary-breakdown">
      <thead>
        <tr><th>Band</th><th>Amount taxed</th><th>Rate</th><th>Tax</th></tr>
      </thead>
      <tbody id="salary-breakdown-body"></tbody>
    </table>
  </div>

  <p class="salary-disclaimer">
    Estimates based on 2024/25 UK tax year bands. This is a guide only and does not constitute financial advice.
  </p>
</div>

<script>
  import { calculateUKSalary } from '../../utils/calculators';
  import { getShareParams, copyShareLink } from '../../utils/shareLink';

  const grossInput = document.getElementById('salary-gross') as HTMLInputElement;
  const pensionInput = document.getElementById('salary-pension') as HTMLInputElement;
  const loanSelect = document.getElementById('salary-loan') as HTMLSelectElement;
  const regionSelect = document.getElementById('salary-region') as HTMLSelectElement;
  const calculateBtn = document.getElementById('salary-calculate') as HTMLButtonElement;
  const resultsBox = document.getElementById('salary-results') as HTMLElement;
  const copyBtn = document.getElementById('salary-copy') as HTMLButtonElement;

  const gbp = new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP' });
  let lastSummary = '';

  function calculate() {
    const grossAnnual = parseFloat(grossInput.value);
    if (Number.isNaN(grossAnnual) || grossAnnual < 0) return;

    const result = calculateUKSalary({
      grossAnnual,
      pensionPercent: parseFloat(pensionInput.value) || 0,
      studentLoanPlan: loanSelect.value as any,
      isScottish: regionSelect.value === 'scotland'
    });

    (document.getElementById('net-annual') as HTMLElement).textContent = gbp.format(result.netAnnual);
    (document.getElementById('net-monthly') as HTMLElement).textContent = gbp.format(result.netMonthly);
    (document.getElementById('net-weekly') as HTMLElement).textContent = gbp.format(result.netWeekly);

    (document.getElementById('row-allowance') as HTMLElement).textContent = gbp.format(result.personalAllowance);
    (document.getElementById('row-taxable') as HTMLElement).textContent = gbp.format(result.taxableIncome);
    (document.getElementById('row-tax') as HTMLElement).textContent = gbp.format(result.incomeTax);
    (document.getElementById('row-ni') as HTMLElement).textContent = gbp.format(result.nationalInsurance);
    (document.getElementById('row-loan') as HTMLElement).textContent = gbp.format(result.studentLoan);
    (document.getElementById('row-pension') as HTMLElement).textContent = gbp.format(result.pensionContribution);
    (document.getElementById('row-rate') as HTMLElement).textContent = `${(result.effectiveTaxRate * 100).toFixed(1)}%`;

    const breakdownBody = document.getElementById('salary-breakdown-body') as HTMLElement;
    breakdownBody.innerHTML = result.breakdown
      .map(
        (b) =>
          `<tr><td>${b.band}</td><td>${gbp.format(b.amount)}</td><td>${(b.rate * 100).toFixed(0)}%</td><td>${gbp.format(b.tax)}</td></tr>`
      )
      .join('');

    lastSummary = [
      `Gross annual salary: ${gbp.format(grossAnnual)}`,
      `Take-home pay (annual): ${gbp.format(result.netAnnual)}`,
      `Take-home pay (monthly): ${gbp.format(result.netMonthly)}`,
      `Take-home pay (weekly): ${gbp.format(result.netWeekly)}`,
      `Income tax: ${gbp.format(result.incomeTax)}`,
      `National Insurance: ${gbp.format(result.nationalInsurance)}`,
      `Student loan repayment: ${gbp.format(result.studentLoan)}`,
      `Pension contribution: ${gbp.format(result.pensionContribution)}`,
      `Effective tax rate: ${(result.effectiveTaxRate * 100).toFixed(1)}%`
    ].join('\n');

    resultsBox.hidden = false;
  }

  calculateBtn.addEventListener('click', calculate);
  [grossInput, pensionInput, loanSelect, regionSelect].forEach((el) =>
    el.addEventListener('change', calculate)
  );

  copyBtn.addEventListener('click', async () => {
    if (!lastSummary) return;
    try {
      await navigator.clipboard.writeText(lastSummary);
      const original = copyBtn.textContent;
      copyBtn.textContent = 'Copied!';
      setTimeout(() => { copyBtn.textContent = original; }, 1500);
    } catch {
      // Clipboard API unavailable — silently ignore.
    }
  });

  const shareBtn = document.getElementById('salary-share') as HTMLButtonElement;
  shareBtn.addEventListener('click', () => {
    copyShareLink(
      {
        gross: grossInput.value,
        pension: pensionInput.value,
        loan: loanSelect.value,
        region: regionSelect.value
      },
      shareBtn
    );
  });

  // Pre-fill from a shared link, e.g. ?gross=45000&pension=5&loan=plan2&region=scotland
  (function restoreFromShareLink() {
    const params = getShareParams();
    const gross = params.get('gross');
    const pension = params.get('pension');
    const loan = params.get('loan');
    const region = params.get('region');

    if (gross) grossInput.value = gross;
    if (pension) pensionInput.value = pension;
    if (loan && Array.from(loanSelect.options).some((o) => o.value === loan)) loanSelect.value = loan;
    if (region && Array.from(regionSelect.options).some((o) => o.value === region)) regionSelect.value = region;
  })();

  calculate();
</script>

<style>
  .salary-calc {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .salary-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .salary-results {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .result-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .result-row .label { margin-bottom: 0; }

  .result-actions {
    display: flex;
    gap: var(--space-2);
  }

  .copy-btn {
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
    padding: 2px 10px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }
  .copy-btn:hover {
    background: var(--color-surface-alt);
    color: var(--color-text);
  }

  .salary-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .summary-item {
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .summary-item strong {
    font-size: 1.3rem;
  }

  td.num { text-align: right; font-family: var(--font-mono); }
  th:not(:first-child) { text-align: right; }
  #salary-breakdown td:not(:first-child) { text-align: right; font-family: var(--font-mono); }

  .salary-disclaimer {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (max-width: 640px) {
    .salary-grid { grid-template-columns: 1fr; }
    .salary-summary { grid-template-columns: 1fr; }
  }
</style>
